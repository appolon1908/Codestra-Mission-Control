# Read-only *staging* dashboard: never expose 8790 directly to the internet.
# Obtain these values from secrets management, not this file.
MISSION_CONTROL_JWT_ISSUER=https://auth-staging.codestra.co/realms/codestra
MISSION_CONTROL_JWT_AUDIENCE=mission-control-backend
MISSION_CONTROL_ALLOWED_AZP=mission-control-ui
# PostgreSQL read-only role with SELECT on products, workstations and atomic_tasks:
CODESTRA_CONTROL_READ_DSN=host=127.0.0.1 port=5432 dbname=codestra_dev_control user=dashboard_reader
MISSION_CONTROL_ALLOWED_ORIGIN=https://dashboard.staging.internal.codestra.agency
# Hard non-activation boundaries:
PRODUCTION_GO=NO
LIVE_CAPABILITIES_ENABLED=NO
EXTERNAL_EFFECTS=false
