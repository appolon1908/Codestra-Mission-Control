{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Codestra Dispatcher Successor Assignment",
  "type": "object",
  "required": [
    "NEXT_TASK_ASSIGNED_DATE",
    "NEXT_MISSION_ID",
    "REPOSITORY",
    "BASE_SHA",
    "LOCAL_WORKTREE/PATH",
    "GOAL",
    "ACCEPTANCE",
    "DEPENDENCIES",
    "DO_NOT_TOUCH"
  ],
  "properties": {
    "NEXT_TASK_ASSIGNED_DATE": {"type": "string", "format": "date-time"},
    "NEXT_MISSION_ID": {"type": "string", "minLength": 1},
    "REPOSITORY": {"type": "string", "minLength": 1},
    "BASE_SHA": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
    "LOCAL_WORKTREE/PATH": {"type": "string", "minLength": 1},
    "GOAL": {"type": "string", "minLength": 1},
    "ACCEPTANCE": {"type": "array", "items": {"type": "string"}},
    "DEPENDENCIES": {"type": "array", "items": {"type": "string"}},
    "DO_NOT_TOUCH": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
